{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "server/api/index.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/employees(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/api(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/index.html"
    }
  ]
}
